{
  "name": "opencode-sessions-sidebar",
  "version": "0.2.0",
  "description": "OpenCode TUI plugin displaying active sessions list in the sidebar",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "install.mjs",
    "README.md"
  ],
  "bin": {
    "opencode-sessions-sidebar": "install.mjs"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "build:tui": "node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sessions",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mangome/opencode-sessions-sidebar.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.24",
    "@opentui/core": "^0.5.16",
    "@opentui/solid": "^0.5.16",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0"
  }
}
